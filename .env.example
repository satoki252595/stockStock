# jp-stock-data-pipeline 環境変数テンプレート
# 実値は .env にコピーして設定（.env は .gitignore 済み・コミットしない）。

# --- Notion / EDINET（収集パイプライン本体） ---------------------------------
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxx
EDINET_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# DB ID は db_ids.json（schema.py 出力）があれば不要。環境変数を設定すると優先される。
# NOTION_DB_STOCK_MASTER=...
# NOTION_DB_PRICES=...
# NOTION_DB_FINANCIALS=...
# NOTION_DB_DISCLOSURES=...
# NOTION_DB_RAW_FILES=...
# NOTION_DB_EXPORTS=...
# NOTION_DB_JOB_LOG=...

# --- ローカル端末B（PostgreSQL）への dual-write + FastAPI 配信（任意） --------
# LOCAL_DB_HOST を設定すると、収集時に Notion と同時にローカル PostgreSQL へ
# ミラー書き込みする。未設定なら Notion のみ（従来動作）。
# 収集パイプラインを動かす端末（端末A）の .env に設定する。
LOCAL_DB_HOST=192.168.1.50          # 端末B の IP（LAN 内）
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=jp_stock
LOCAL_DB_USER=jp_stock
LOCAL_DB_PASSWORD=change-me

# --- FastAPI（端末B で起動する API サーバ） ----------------------------------
# X-API-Key 認証のキー。未設定だと認証なしで起動する（信頼できる LAN 内のみ推奨）。
LOCAL_API_KEY=change-me-to-a-long-random-string
# 任意: listen するホスト/ポート（既定 0.0.0.0:8000）
# LOCAL_API_HOST=0.0.0.0
# LOCAL_API_PORT=8000
