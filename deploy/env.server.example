# 本番サーバ（トポロジ B）用 .env テンプレート。
# サーバは FastAPI だけを動かす（収集は GitHub Actions）。よって Notion/EDINET の
# 資格情報は不要で、ローカル PostgreSQL 接続 + API 設定のみでよい。
# 実値を入れて /opt/jp-stock-pipeline/.env へ置く（.gitignore 済み・コミットしない）。

# --- ローカル PostgreSQL（API は lan プロファイル=localhost で自DB接続） ---------
LOCAL_DB_NAME=jp_stock
LOCAL_DB_USER=jp_stock
LOCAL_DB_PASSWORD=__set_me__          # deploy/postgres/init.sql で設定した値
LOCAL_DB_PORT=5432
# LOCAL_DB_LAN_HOST は未設定でよい（API は localhost に自動補完）。

# --- FastAPI ---------------------------------------------------------------
LOCAL_API_KEY=__set_a_long_random_string__   # 必須。X-API-Key 認証（未設定だと無認証起動）
LOCAL_API_HOST=100.x.y.z              # サーバの tailscale IP（tailnet からのみ到達可にする）
LOCAL_API_PORT=8000

# 注意: NOTION_TOKEN / EDINET_API_KEY / LOCAL_DB_HOST はサーバ側では不要。
#       それらは GitHub Actions の Secrets に設定する（deploy/README.md §3）。
